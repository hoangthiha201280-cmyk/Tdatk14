local function GetSavedKeyTime()
    return getgenv().TDATHUB_KeyTime
end

local function KeyStillValid()
    local SavedTime = GetSavedKeyTime()

    if SavedTime then
        return os.time() - SavedTime < KeyDuration
    end

    return false
end

local function ActivateKey()
    getgenv().TDATHUB_KeyTime = os.time()
end

