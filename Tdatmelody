    EnemyCount.AnchorPoint = Vector2.new(0.5,0)
    EnemyCount.Position = UDim2.new(0.5,0,0,58)
    EnemyCount.Size = UDim2.fromOffset(180,34)
    EnemyCount.BackgroundTransparency = 1
    EnemyCount.Text = "Địch: 0"
    EnemyCount.TextColor3 = Color3.fromRGB(255,80,80)
    EnemyCount.TextStrokeTransparency = 0
    EnemyCount.TextScaled = true
    EnemyCount.Font = Enum.Font.GothamBold
    EnemyCount.Parent = MainGui

    local function IsEnemy(Player)
        if Player == LocalPlayer then
            return false
        end

        if LocalPlayer.Team and Player.Team then
            return Player.Team ~= LocalPlayer.Team
        end

        return true
    end

    local function UpdateEnemyCount()
        local Count = 0

        for _,Player in ipairs(Players:GetPlayers()) do
            if IsEnemy(Player) then
                Count += 1
            end
        end

        EnemyCount.Text = "Địch: " .. Count
    end

    --==================================================
    -- TARGET
    --==================================================

    local function GetTarget()
        local BestPlayer = nil
        local BestDistance = math.huge

        local Viewport = Camera.ViewportSize

        local Center = Vector2.new(
            Viewport.X/2,
            Viewport.Y/2
        )

        local Radius = S.FOVSize/2

        for _,Player in ipairs(Players:GetPlayers()) do

            if IsEnemy(Player) then

                local Character = Player.Character

                if Character then

                    local Humanoid =
                        Character:FindFirstChildOfClass(
                            "Humanoid"
                        )

                    local Root =
                        Character:FindFirstChild(
                            "HumanoidRootPart"
                        )

                    if Humanoid
                    and Root
                    and Humanoid.Health > 0 then

                        local ScreenPos,Visible =
                            Camera:WorldToViewportPoint(
                                Root.Position
                            )

                        if Visible then

                            local Pos = Vector2.new(
                                ScreenPos.X,
                                ScreenPos.Y
                            )

                            local Distance =
                                (Pos-Center).Magnitude

                            if Distance <= Radius
                            and Distance < BestDistance then

                                BestDistance = Distance
                                BestPlayer = Player
                            end
                        end
                    end
                end
            end
        end

        return BestPlayer
    end

    --==================================================
    -- TARGET PART
    --==================================================

    local function GetTargetPart(Player)

        if not Player
        or not Player.Character then
            return nil
        end

        local Character = Player.Character

        if S.TargetPart == "Head" then

            return Character:FindFirstChild("Head")
                or Character:FindFirstChild(
                    "HumanoidRootPart"
                )

        elseif S.TargetPart == "Torso" then

            return Character:FindFirstChild("UpperTorso")
                or Character:FindFirstChild("Torso")
                or Character:FindFirstChild(
                    "HumanoidRootPart"
                )

        else

            return Character:FindFirstChild(
                "HumanoidRootPart"
            )
        end
    end

    --==================================================
    -- ATTACK INPUT
    --==================================================

    UserInputService.InputBegan:Connect(
        function(Input,Processed)

            if Processed then
                return
            end

            if Input.UserInputType ==
                Enum.UserInputType.MouseButton1 then

                Attacking = true

                if S.AttackLock and S.Aim then
                    LockedTarget = GetTarget()
                end
            end
        end
    )

    UserInputService.InputEnded:Connect(
        function(Input)

            if Input.UserInputType ==
                Enum.UserInputType.MouseButton1 then

                Attacking = false
                LockedTarget = nil
            end
        end
    )

    --==================================================
    -- AIM
    --==================================================

    local function UpdateAim()

        if not S.Aim then
            return
        end

        if S.AttackLock and not Attacking then
            return
        end

        if not LockedTarget then
            LockedTarget = GetTarget()
        end

        if not LockedTarget then
            return
        end

        local Part =
            GetTargetPart(LockedTarget)

        if not Part then
            LockedTarget = nil
            return
        end

        local Character =
            LockedTarget.Character

        local Humanoid =
            Character and
            Character:FindFirstChildOfClass(
                "Humanoid"
            )

        if not Humanoid
        or Humanoid.Health <= 0 then

            LockedTarget = nil
            return
        end

        local Goal =
            CFrame.lookAt(
                Camera.CFrame.Position,
                Part.Position
            )

        Camera.CFrame =
            Camera.CFrame:Lerp(
                Goal,
                0.20
            )
    end

    --==================================================
    -- ESP
    --==================================================

    local function RemoveESP(Player)

        local Data = ESPObjects[Player]

        if not Data then
            return
        end

        if Data.Highlight then
            Data.Highlight:Destroy()
        end

        if Data.Billboard then
            Data.Billboard:Destroy()
        end

        if Data.Line then
            Data.Line:Destroy()
        end

        ESPObjects[Player] = nil
    end

    local function CreateESP(Player)

        if Player == LocalPlayer then
            return
        end

        RemoveESP(Player)

        local Character = Player.Character

        if not Character then
            return
        end

        local Root =
            Character:FindFirstChild(
                "HumanoidRootPart"
            )

        if not Root then
            return
        end

        local Data = {}

        -- BOX
        local Highlight = Instance.new("Highlight")

        Highlight.Name = "TDAT_Box"
        Highlight.Adornee = Character
        Highlight.FillTransparency = 1
        Highlight.OutlineTransparency = 0
        Highlight.DepthMode =
            Enum.HighlightDepthMode.AlwaysOnTop

        Highlight.Enabled =
            S.ESP and S.Box

        Highlight.Parent = Character

        Data.Highlight = Highlight

        -- NAME / HEALTH
        local Billboard =
            Instance.new("BillboardGui")

        Billboard.Name = "TDAT_Info"
        Billboard.Adornee = Root
        Billboard.Size =
            UDim2.fromOffset(150,45)

        Billboard.StudsOffset =
            Vector3.new(0,3,0)

        Billboard.AlwaysOnTop = true

        Billboard.Enabled =
            S.ESP and
            (S.Name or S.Health)

        Billboard.Parent = Character

        local Label =
            Instance.new("TextLabel")

        Label.Size = UDim2.fromScale(1,1)
        Label.BackgroundTransparency = 1
        Label.TextColor3 =
            Color3.fromRGB(255,255,255)

        Label.TextStrokeTransparency = 0
        Label.TextScaled = true
        Label.Font = Enum.Font.GothamBold
        Label.Parent = Billboard

        Data.Billboard = Billboard
        Data.Label = Label

        -- LINE
        local Line = Instance.new("Frame")

        Line.Name = "TDAT_Line"
        Line.AnchorPoint =
            Vector2.new(0.5,0.5)

        Line.BorderSizePixel = 0
        Line.BackgroundColor3 =
            S.LineColor

        Line.Visible =
            S.ESP and S.Line

        Line.Parent = MainGui

        Data.Line = Line

        ESPObjects[Player] = Data
    end

    local function UpdateESP(Player)

        local Data = ESPObjects[Player]

        if not Data then
            CreateESP(Player)
            Data = ESPObjects[Player]
        end

        if not Data then
            return
        end

        local Character = Player.Character

        if not Character then
            RemoveESP(Player)
            return
        end

        local Root =
            Character:FindFirstChild(
                "HumanoidRootPart"
            )

        local Humanoid =
            Character:FindFirstChildOfClass(
                "Humanoid"
            )

        if not Root or not Humanoid then
            return
        end

        Data.Highlight.Enabled =
            S.ESP and S.Box

        Data.Billboard.Enabled =
            S.ESP and
            (S.Name or S.Health)

        local Text = ""

        if S.Name then
            Text = Player.DisplayName
        end

        if S.Health then

            if Text ~= "" then
                Text = Text .. "\n"
            end

            Text = Text ..
                "HP: " ..
                math.floor(Humanoid.Health)
        end

        Data.Label.Text = Text

        Data.Line.Visible =
            S.ESP and S.Line

        Data.Line.BackgroundColor3 =
            S.LineColor

        if S.ESP and S.Line then

            local ScreenPos,Visible =
                Camera:WorldToViewportPoint(
                    Root.Position
                )

            if Visible then

                local Start =
                    Vector2.new(
                        Camera.ViewportSize.X/2,
                        Camera.ViewportSize.Y
                    )

                local Finish =
                    Vector2.new(
                        ScreenPos.X,
                        ScreenPos.Y
                    )

                local Difference =
                    Finish-Start

                Data.Line.Position =
                    UDim2.fromOffset(
                        (Start.X+Finish.X)/2,
                        (Start.Y+Finish.Y)/2
                    )

                Data.Line.Size =
                    UDim2.fromOffset(
                        Difference.Magnitude,
                        2
                    )

                Data.Line.Rotation =
                    math.deg(
                        math.atan2(
                            Difference.Y,
                            Difference.X
                        )
                    )

            else
                Data.Line.Visible = false
            end
        end
    end

